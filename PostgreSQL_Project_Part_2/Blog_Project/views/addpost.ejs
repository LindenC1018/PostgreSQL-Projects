
<%- include("partials/header"); -%>

<h3>Add A New Post</h3>
<form class="" action="/addpost" method="post" enctype="multipart/form-data">
<table>
    <tr>
        <th>Post Title:</th>
        <td><input type="text" name="posttitle" placeholder="Type Title Here"></td>
    </tr>
    <tr>
        <th>Choose Category:</th>
        <td><select name="category">
            <% for(let item of category){ %>

            <option><%= item.categorytitle %></option>
            <% } %>

        </select>
        </td>
    </tr>
    <tr>
        <th>My File:</th>
        <td><label for="imageSelect" >Select An Image</label>&nbsp;&nbsp;&nbsp;
        <input type="file" name="image"><br />
        </td>	
    </tr>
    <tr>
        <th>Author</th>
        <td><input type="text" name="author" value="<%= admin.adminname %>"></td>
    </tr>
    <tr>
        <th>Post:</th>
    <td><textarea name="postdescription" rows="5" cols="80">
        </textarea></td>
    </tr>
    <tr>
        <td><input type="submit" name="submit" value="Publish"></td>
        <td><a href="dashboard.php"><input type="button" value="Back To Dashboard"></a></td>
    </tr>
</table>
</form>

<%- include("partials/footer"); -%>